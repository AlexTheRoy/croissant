{
  "name": "croissant",
  "version": "2.0.0",
  "private": true,
  "description": "Budget Pace Alerts: a bookmarklet that watches GOAL daily ad spend and alerts at budget thresholds.",
  "scripts": {
    "build": "node build.mjs",
    "build:example": "node build.mjs --config accounts.example.json --out dist-example",
    "test": "node --test",
    "e2e": "npm run build:example && node scripts/e2e.cjs"
  },
  "devDependencies": {
    "terser": "5.31.6"
  },
  "engines": {
    "node": ">=18"
  }
}
